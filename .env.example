# TrueFace AI-X — Environment Variables Template
# Copy this file to .env and replace placeholders with your local environment values.

# -----------------------------------------------------------------------------
# General Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TrueFace AI-X"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trueface_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trueface_db

# -----------------------------------------------------------------------------
# Vector Store Configuration (FAISS / Qdrant)
# -----------------------------------------------------------------------------
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=backend/app/search/indices/face_gallery.index
IDENTITY_MAPPING_PATH=backend/app/search/indices/identity_mapping.json
VECTOR_DIMENSION=512

# -----------------------------------------------------------------------------
# Model Paths & Checkpoint Registry
# -----------------------------------------------------------------------------
FACE_DETECTOR_MODEL_PATH=models/face/detection
FACE_RECOGNITION_MODEL_PATH=models/face/recognition
FACE_LIVENESS_MODEL_PATH=models/liveness/pad_model.onnx
FACE_DEEPFAKE_MODEL_PATH=models/deepfake/manipulation_model.onnx
VOICE_VAD_MODEL_PATH=models/voice/vad
VOICE_SPEAKER_MODEL_PATH=models/voice/speaker_verification
VOICE_ANTISPOOF_MODEL_PATH=models/audio_antispoof/synthetic_speech_model.onnx

# -----------------------------------------------------------------------------
# Biometric Decision Policy & Thresholds (Defaults for Validation)
# -----------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.75
VOICE_MATCH_THRESHOLD=0.70
FACE_LIVENESS_MIN_CONFIDENCE=0.80
VOICE_LIVENESS_MIN_CONFIDENCE=0.80
FUSION_WEIGHT_FACE=0.60
FUSION_WEIGHT_VOICE=0.40

# -----------------------------------------------------------------------------
# Audit & Logging Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=true
MASK_EMBEDDINGS_IN_LOGS=true

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

