ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TrueFace AI-X"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase PostgreSQL connection.
# Copy the Session pooler URI from Supabase Dashboard > Connect and replace
# the pooler username, password, and project host. Keep ssl=require.
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@db.project-ref.supabase.co:5432/postgres?ssl=require

POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=backend/app/search/indices/face_gallery.index
IDENTITY_MAPPING_PATH=backend/app/search/indices/identity_mapping.json
VECTOR_DIMENSION=512

FACE_DETECTOR_MODEL_PATH=models/face/detection
FACE_RECOGNITION_MODEL_PATH=models/face/recognition
FACE_MODEL_PACK=buffalo_l
FACE_LIVENESS_MODEL_PATH=models/liveness/anti-spoof-mn3.onnx
FACE_DEEPFAKE_MODEL_PATH=models/deepfake/deepfake_detector.onnx
VOICE_VAD_MODEL_PATH=models/voice/vad
VOICE_SPEAKER_MODEL_PATH=models/voice/speaker_verification
VOICE_SPEAKER_ENABLED=true
VOICE_SPEAKER_HF_SOURCE=speechbrain/spkrec-ecapa-voxceleb
VOICE_SPEAKER_DEVICE=cpu
VOICE_EMBEDDING_DIMENSION=192
VOICE_INFERENCE_TIMEOUT=10.0

# Voice anti-spoofing (AASIST, pretrained on ASVspoof 2019 LA).
# Weights bundled at models/voice/anti_spoofing/AASIST.pth (or AASIST-L.pth).
VOICE_ANTISPOOF_ENABLED=true
VOICE_ANTISPOOF_MODEL_PATH=models/voice/anti_spoofing/AASIST.pth
VOICE_ANTISPOOF_DEVICE=cpu
VOICE_ANTISPOOF_THRESHOLD=0.5

FACE_MATCH_THRESHOLD=0.75
VOICE_MATCH_THRESHOLD=0.70
FACE_LIVENESS_MIN_CONFIDENCE=0.80
VOICE_LIVENESS_MIN_CONFIDENCE=0.80
FUSION_WEIGHT_FACE=0.60
FUSION_WEIGHT_VOICE=0.40

LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=true
MASK_EMBEDDINGS_IN_LOGS=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
